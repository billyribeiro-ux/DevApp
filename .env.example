# DevVault Desktop App
VITE_SYNC_SERVER_URL=http://localhost:8090

# DevVault Sync Server (run from sync-server/)
HOST=0.0.0.0
PORT=8090
DATABASE_URL=sqlite:devvault-sync.db?mode=rwc
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRY_HOURS=720
STORAGE_PATH=./vault-storage
MAX_FILE_SIZE_MB=100
